---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterList from '../../components/FilterList.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import { projects, projectTypes } from '../../data/projects';
---
<BaseLayout title="项目档案索引 — 爱二开网" description="i2kai 的项目详情索引，包含当前项目、原型与历史交付案例。">
  <header class="page-intro compact-intro">
    <a class="back-link" href="/projects/">← 项目目录</a>
    <h1>项目档案索引</h1>
    <p>浏览当前项目、原型与历史交付记录。</p>
  </header>
  <FilterList id="archive-results" label="搜索项目档案" categories={projectTypes} categoryLabel="项目类型" initialCount={projects.length}>
    <ul class="line-list">{projects.map((project) => <ProjectRow project={project} heading={2} />)}</ul>
  </FilterList>
</BaseLayout>
