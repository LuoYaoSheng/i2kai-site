---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contacts, personalInfo } from '../data/site';
---
<BaseLayout title={`联系 — ${personalInfo.name}`}>
  <header class="page-intro directory-intro">
    <div><h1>联系方式</h1><p>欢迎交流技术、讨论项目或提出反馈。</p></div>
    <a class="directory-link" href="/about/">← 关于老罗</a>
  </header>
  <div class="directory-resources contact-layout">
    <section>
      <h2>联系老罗</h2>
      <dl class="case-facts">
        {contacts.slice(0, 3).map((contact) => <div><dt>{contact.label}</dt><dd><a href={contact.href}>{contact.value}</a></dd></div>)}
        <div><dt>备用邮箱</dt><dd><a href="mailto:1034639560@qq.com">1034639560@qq.com</a></dd></div>
        <div><dt>电话</dt><dd><a href="tel:+8615980116983">+86 15980116983</a></dd></div>
        <div><dt>地区</dt><dd>{personalInfo.location}</dd></div>
      </dl>
    </section>
    <section>
      <h2>微信公众号</h2>
      <div class="contact-channels">
        <figure><img src="/wechat-qr.jpg" alt="极客第一行公众号二维码" width="140" height="140" loading="lazy" /><figcaption><strong>{personalInfo.wechatPublic}</strong><br />技术文章与项目实践</figcaption></figure>
        <figure><img src="/wechat-qr-2.jpg" alt="落落在厦公众号二维码" width="140" height="140" loading="lazy" /><figcaption><strong>{personalInfo.wechatPublic2}</strong><br />生活记录</figcaption></figure>
      </div>
    </section>
  </div>
</BaseLayout>
