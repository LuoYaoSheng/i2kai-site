---
import BaseLayout from '../layouts/BaseLayout.astro';
import UpdateList from '../components/UpdateList.astro';
import ProjectRow from '../components/ProjectRow.astro';
import VideoRow from '../components/VideoRow.astro';
import { contacts, personalInfo, siteMeta } from '../data/site';
import { getProject } from '../data/projects';
import { isShare, recentEntries, videos } from '../data/content';

const [updates, allVideos] = await Promise.all([recentEntries(), videos()]);
const shares = allVideos.filter(isShare).slice(0, 2);
const projectGroups = [
  { name: '软件与开发工具', slugs: ['smart-ble', 'batch-image-studio'] },
  { name: '开源硬件与 DIY', slugs: ['queue-caller'] },
  { name: 'IoT 与智能设备', slugs: ['open-iot-platform', 'esp32-c3-weather-station'] },
  { name: 'AI 与实验项目', slugs: ['modular-ai-robot-kit'] },
].map(({ name, slugs }) => ({ name, projects: slugs.flatMap((slug) => getProject(slug) ?? []) }));
const practices = updates.filter((entry) => ['实践记录', '实验记录'].includes(entry.type)).slice(0, 4);
---
<BaseLayout title="i2kai / 爱二开网" description={siteMeta.description}>
  <section class="home-intro" aria-labelledby="home-title">
    <div class="home-person">
      <img class="home-avatar" src="/images/site/laoluo-256.webp" alt="老罗" width="84" height="84" decoding="async" />
      <div>
        <h1 id="home-title">你好，我是{personalInfo.nickname}。</h1>
        <p class="home-tagline">{siteMeta.title}</p>
      </div>
    </div>
    <div class="home-intro-details">
      <div>
        <p class="home-identity">{personalInfo.name} · {personalInfo.title}</p>
        <p class="home-summary">{siteMeta.description}</p>
      </div>
      <div class="text-links home-links">
        <a href={contacts[0].href}>GitHub ↗</a>
        <a href={contacts[1].href}>Gitee ↗</a>
        <a href="/rss.xml">RSS</a>
        <a href="/about/">关于我 →</a>
      </div>
    </div>
  </section>

  <div class="home-reading-desk">
    <section class="home-feature" aria-labelledby="feature-title">
      <div class="section-head"><h2 id="feature-title">从一个项目开始</h2><a href="/projects/">浏览项目 →</a></div>
      <article>
        <a class="feature-story" href="/blog/2026-04-12-batch-image-studio/">
          <p class="entry-meta">Batch Image Studio · 开源桌面工具</p>
          <h3>把重复的图片处理，交给一个模板。</h3>
          <div class="home-figure">
            <img src="/images/site/batch-image-studio-960.webp"
              srcset="/images/site/batch-image-studio-480.webp 480w, /images/site/batch-image-studio-960.webp 960w"
              sizes="(max-width: 46rem) calc(100vw - 2.5rem), (max-width: 72rem) 54vw, 39rem"
              alt="Batch Image Studio 桌面应用的图片导入和模板入口，原版开发截图" width="1540" height="960" fetchpriority="high" decoding="async" />
          </div>
          <p class="feature-description">用 Tauri + React 做一个本地图片工具，从模板复用到 AI 修复，分享实现过程。</p>
          <span class="feature-read">阅读开发记录 <span aria-hidden="true">→</span></span>
        </a>
      </article>
      <nav class="home-starting-points" aria-label="更多技术主题">
        <a href="/blog/2026-04-10-smart-ble-multi-platform/"><span>软件与设备</span><strong>同一个蓝牙工具，如何适配多个平台？</strong><span aria-hidden="true">→</span></a>
        <a href="/showcase/queue-caller/"><span>硬件与 DIY</span><strong>从数码管和按钮，做一个离线叫号器</strong><span aria-hidden="true">→</span></a>
      </nav>
    </section>

    <section class="home-updates" aria-labelledby="updates-title">
      <div class="section-head">
        <h2 id="updates-title">最近更新</h2>
        <a href="/search/">全部更新 →</a>
      </div>
      <UpdateList entries={updates.slice(0, 6)} />
      <a class="home-article-link" href="/blog/">继续读文章 →</a>
    </section>
  </div>

  <section class="home-section" aria-labelledby="projects-title">
    <div class="section-head">
      <h2 id="projects-title">开源项目与原型</h2>
      <a href="/projects/">全部项目 <span aria-hidden="true">→</span></a>
    </div>
    <div class="home-project-groups">
      {projectGroups.map((group) => (
        <section class="home-project-group" aria-label={group.name}>
          <h3>{group.name}</h3>
          <ul class="line-list">{group.projects.map((project) => <ProjectRow project={project} heading={4} />)}</ul>
        </section>
      ))}
    </div>
  </section>

  <section class="home-section" aria-labelledby="videos-title">
    <div class="section-head">
      <h2 id="videos-title">视频分享</h2>
      <a href="/videos/">全部视频 <span aria-hidden="true">→</span></a>
    </div>
    {shares.length > 0 ? <ul class="line-list">{shares.map((video) => <VideoRow video={video} />)}</ul> : <p>已保留历史视频笔记。</p>}
  </section>

  <section class="home-section" aria-labelledby="practice-title">
    <div class="section-head">
      <h2 id="practice-title">技术记录</h2>
      <a href="/blog/">查看文章 <span aria-hidden="true">→</span></a>
    </div>
    <UpdateList entries={practices} />
  </section>
</BaseLayout>
