---
import { videoCategories } from '../../data/taxonomy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterList from '../../components/FilterList.astro';
import VideoRow from '../../components/VideoRow.astro';
import { isoDate, isShare, videoPath, videos } from '../../data/content';

const all = await videos();
const shares = all.filter(isShare);
const notes = all.filter((video) => !isShare(video));
---
<BaseLayout title="视频 — 爱二开网" description="来自 Bilibili、YouTube 等原站的技术视频书签与观看笔记。">
  <header class="page-intro directory-intro">
    <div><h1>视频</h1><p>分享来自 Bilibili、YouTube 等平台的视频，附推荐理由和观看笔记。每条分享都标注原作者，并提供对应的原站链接。</p></div>
    {notes.length > 0 && <a class="directory-link" href="#video-notes">历史视频笔记 ↓</a>}
  </header>

  <section class="video-library" aria-labelledby="recent-videos">
    <div class="section-head"><h2 id="recent-videos">最近分享</h2></div>
    {shares.length > 0 ? <FilterList id="video-results" label="搜索视频" categories={videoCategories} initialCount={shares.length}>
      <ul class="line-list video-collection">{shares.map((video) => <VideoRow video={video} showFeatured />)}</ul>
    </FilterList> : <p>暂无已收录的外部视频。</p>}
  </section>

  {notes.length > 0 && <section class="section" aria-labelledby="video-notes">
    <div class="section-head"><h2 id="video-notes">历史视频笔记</h2></div>
    <ul class="line-list">{notes.map((note) => (
      <li class="article-row">
        <time class="entry-date" datetime={isoDate(note.data.date)}>{isoDate(note.data.date)}</time>
        <div><h3><a href={videoPath(note)}>{note.data.title}</a></h3><p>{note.data.description}</p></div>
      </li>
    ))}</ul>
  </section>}
</BaseLayout>
