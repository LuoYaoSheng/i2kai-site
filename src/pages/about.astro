---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contacts, education, experiences, personalInfo, philosophy, siteMeta, skills, timeline } from '../data/site';
---
<BaseLayout title="关于老罗 — 爱二开网" description={personalInfo.bio}>
  <article class="about-page">
    <header class="about-profile">
      <div class="about-identity">
        <img src="/images/site/laoluo-256.webp" alt="" width="112" height="112" decoding="async" />
        <div>
          <h1>关于{personalInfo.nickname}</h1>
          <p>{personalInfo.name} · {personalInfo.alias}</p>
          <p class="entry-meta">{personalInfo.title}</p>
        </div>
      </div>
      <div class="about-intro">
        <p>{personalInfo.bio}</p>
        <p>我用 {personalInfo.alias} 这个名字写文章和维护开源项目，喜欢把想法做成桌面工具、开发板原型或能实际操作的小设备。爱二开网用来记录这些过程，也收藏值得回看的技术视频。</p>
        <p class="about-motto">{siteMeta.title}</p>
      </div>
    </header>

    <div class="about-content">
      <section class="about-interests" aria-labelledby="interests-title">
        <h2 id="interests-title">正在探索</h2>
        <ul class="line-list">
          <li class="link-row"><a href="/showcase/smart-ble/">蓝析 BLE</a><p>跨平台蓝牙调试和设备联调</p></li>
          <li class="link-row"><a href="/showcase/open-iot-platform/">Open IoT Platform</a><p>设备接入、配网与移动端控制</p></li>
          <li class="link-row"><a href="/projects/">硬件与 DIY 原型</a><p>离线设备、传感器和可试配的 3D 结构</p></li>
        </ul>
      </section>

      <section class="about-approach" aria-labelledby="approach-title">
        <h2 id="approach-title">{personalInfo.tagline}</h2>
        <ol class="about-principles">{philosophy.map((item) => <li><strong>{item.title}</strong><p>{item.description}</p></li>)}</ol>
        <p class="about-story"><a href="/blog/2026-04-15-hello-world/">我为什么公开做开源 →</a></p>
      </section>

      <details class="about-background">
        <summary>技术背景与经历</summary>
        <p>{education.school} · {education.major} · {education.degree} · {education.period}</p>
        <ul class="plain-links">{timeline.map((item) => <li><strong>{item.year} · {item.title}</strong><p>{item.description}</p></li>)}</ul>
        <h3 class="about-experiences">既往工作</h3>
        <ul class="plain-links">{experiences.map((item) => <li>{item.role} <span class="entry-meta">· {item.period}</span></li>)}</ul>
        <p class="entry-meta">{[...skills.core.map((item) => item.name), ...skills.domains.map((item) => item.name), ...skills.extras].join(' · ')}</p>
      </details>

      <section class="about-contact" aria-labelledby="about-contact-title">
        <h2 id="about-contact-title">联系与订阅</h2>
        <p>欢迎交流技术、讨论开源项目，也欢迎分享你做过的东西。</p>
        <div class="text-links">
          {contacts.slice(0, 3).map((contact) => <a href={contact.href}>{contact.label}</a>)}<a href="/rss.xml">RSS</a><a href="/contact/">其他联系方式</a>
        </div>
      </section>
    </div>
  </article>
</BaseLayout>
