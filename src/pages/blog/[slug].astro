---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleContents from '../../components/ArticleContents.astro';
import ContentContext from '../../components/ContentContext.astro';
import { render } from 'astro:content';
import { articlePath, articles, isoDate, isShare, linkedProjects, videoPath, videos, type Post } from '../../data/content';

export async function getStaticPaths() {
  return (await articles()).map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
const [{ Content, headings }, posts, allVideos] = await Promise.all([render(post), articles(), videos()]);
const index = posts.findIndex((item) => item.slug === post.slug);
const newer = posts[index - 1];
const older = posts[index + 1];
const projectIds = linkedProjects(post.data);
const related = posts.filter((item) => item.slug !== post.slug && (
  linkedProjects(item.data).some((id) => projectIds.includes(id)) || item.data.category === post.data.category
)).slice(0, 4);
const relatedVideos = allVideos.filter(isShare).filter((video) => video.data.articleIds.includes(post.slug));
const toc = headings.filter(({ depth }) => depth === 2 || depth === 3);
const { date, updated, category, tags } = post.data;
---
<BaseLayout title={`${post.data.title} — 爱二开网`} description={post.data.description} image={post.data.heroImage}>
  <article class="reading article-page">
    <a class="back-link" href="/blog/">← 全部文章</a>
    <header class="page-intro reading-intro">
      <p class="entry-meta">{category}</p>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="publication-meta">
        <span>发布于 <time datetime={isoDate(date)}>{isoDate(date)}</time></span>
        {updated && <span>更新于 <time datetime={isoDate(updated)}>{isoDate(updated)}</time></span>}
      </div>
      {tags.length > 0 && <p class="entry-meta post-tags">{tags.join(' · ')}</p>}
    </header>
    {toc.length > 0 && <details class="table-of-contents article-toc-mobile">
      <summary>文章目录</summary>
      <ArticleContents headings={toc} />
    </details>}
    <div class="article-layout">
      {toc.length > 0 && <aside class="article-toc-sidebar">
        <div class="table-of-contents">
          <h2>文章目录</h2>
          <ArticleContents headings={toc} />
        </div>
      </aside>}
      <div class="article-main">
        <ContentContext projectIds={projectIds} seriesIds={post.data.seriesIds} showProjectNotice={!post.data.hasUpdateNotice} />
        <div class="prose"><Content /></div>
        {(newer || older) && <nav class="adjacent-articles" aria-label="相邻文章">
          {older && <div><span>上一篇 · 较早</span><a href={articlePath(older)}>{older.data.title}</a></div>}
          {newer && <div><span>下一篇 · 较新</span><a href={articlePath(newer)}>{newer.data.title}</a></div>}
        </nav>}
        {related.length > 0 && <section class="section"><h2>相关文章</h2><ul class="plain-links">{related.map((item) => <li><a href={articlePath(item)}>{item.data.title}</a></li>)}</ul></section>}
        {relatedVideos.length > 0 && <section class="section"><h2>相关视频</h2><ul class="plain-links">{relatedVideos.map((item) => <li><a href={videoPath(item)}>{item.data.title}</a></li>)}</ul></section>}
      </div>
    </div>
  </article>
</BaseLayout>
