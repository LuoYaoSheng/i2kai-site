---
import '../styles/global.css';
import '../styles/sections.css';
import { contacts, seoMeta, siteMeta } from '../data/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = siteMeta.description, image } = Astro.props;
const path = Astro.url.pathname;
const canonicalURL = new URL(path.endsWith('/') ? path : path + '/', seoMeta.siteUrl);
const ogImage = new URL(image || seoMeta.ogImage, seoMeta.siteUrl);
const navItems = [
  { label: '首页', href: '/' },
  { label: '文章', href: '/blog/' },
  { label: '项目', href: '/projects/' },
  { label: '视频', href: '/videos/' },
  { label: '关于', href: '/about/' },
];
const active = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href) || (href === '/projects/' && /^\/(showcase|series)\//.test(path));
const github = contacts[0].href;
const gitee = contacts[1].href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="爱二开网 RSS" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={seoMeta.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="keywords" content={seoMeta.keywords} />
    <meta name="author" content={seoMeta.author} />
    <meta name="theme-color" content={seoMeta.themeColor} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="i2kai 爱二开网首页">i<span>2</span>kai<small>爱二开网</small></a>
        <nav class="site-nav" aria-label="主导航">
          {navItems.map(({ label, href }) => (
            <a href={href} class:list={[active(href) && 'active']} aria-current={path === href ? 'page' : active(href) ? 'location' : undefined}>{label}</a>
          ))}
        </nav>
        <div class="header-utilities">
          <a href="/search/">搜索</a>
          <a href={github} class="desktop-utility">GitHub</a>
          <a href="/rss.xml" class="desktop-utility">RSS</a>
        </div>
      </div>
    </header>

    <main class="shell site-main" id="main-content" tabindex="-1"><slot /></main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <div>
          <strong>i2kai / 爱二开网</strong>
          <p>个人技术探索与开源分享空间</p>
        </div>
        <div>
          <nav aria-label="页脚导航" class="text-links">
            <a href="/about/">关于 i2kai</a><a href={github}>GitHub</a><a href={gitee}>Gitee</a>
            <a href="/rss.xml">RSS</a><a href="/contact/">联系方式</a>
          </nav>
          <p>© {new Date().getFullYear()} {seoMeta.author} <span aria-hidden="true">·</span> <a href="https://beian.miit.gov.cn/">闽ICP备2022003862号</a></p>
        </div>
      </div>
    </footer>

    <script>
      const resizeObserver = typeof ResizeObserver === 'function'
        ? new ResizeObserver((entries) => entries.forEach(({ target }) => {
            (target as HTMLElement).tabIndex = target.scrollWidth > target.clientWidth ? 0 : -1;
          }))
        : undefined;

      document.querySelectorAll<HTMLElement>('.prose pre').forEach((element) => {
        element.setAttribute('role', 'region');
        element.setAttribute('aria-label', '代码片段，可横向滚动');
        element.tabIndex = 0;
        resizeObserver?.observe(element);
      });

      document.querySelectorAll('.prose').forEach((article) => {
        let section = document.querySelector('main h1')?.textContent?.trim() || '正文';
        let tableNumber = 0;
        article.querySelectorAll('h2, h3, h4, h5, h6, table').forEach((element) => {
          if (!(element instanceof HTMLTableElement)) {
            section = element.textContent?.trim() || section;
            return;
          }
          const region = document.createElement('div');
          region.className = 'prose-table-scroll';
          region.setAttribute('role', 'region');
          region.setAttribute('aria-label', (element.caption?.textContent?.trim() || section) + ' · 表格 ' + (++tableNumber));
          region.tabIndex = 0;
          element.before(region);
          region.append(element);
          resizeObserver?.observe(region);
        });
      });

      document.querySelectorAll<HTMLImageElement>('img[data-remote]').forEach((image) => {
        function showFallback() {
          if (image.hidden) return;
          image.hidden = true;
          const note = document.createElement('p');
          note.className = 'media-unavailable';
          note.textContent = '原站图片暂不可用';
          image.after(note);
        }
        image.addEventListener('error', showFallback);
        if (image.complete && !image.naturalWidth) showFallback();
      });
    </script>
  </body>
</html>
