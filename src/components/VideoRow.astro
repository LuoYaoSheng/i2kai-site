---
import { isoDate, videoPath, videoSource, type VideoShare } from '../data/content';
const { video, showFeatured = false } = Astro.props as { video: VideoShare; showFeatured?: boolean };
const data = video.data;
---
<li class="video-row" data-filter-row data-categories={data.category} data-search={[data.title, data.originalAuthor, videoSource(video).name, data.category, data.recommendation, ...data.tags].join(' ')}>
  <div class="video-thumbnail"><img src={data.cover} data-remote alt="" width="320" height="180" loading="lazy" decoding="async" referrerpolicy="no-referrer" /></div>
  <div class="video-row-copy">
    <p class="entry-meta">{showFeatured && data.featured && <strong class="video-featured">精选 · </strong>}{videoSource(video).name} · {data.originalAuthor} · {data.category}</p>
    <h3><a href={videoPath(video)}>{data.title}</a></h3>
    <p>{data.recommendation}</p>
    <time class="entry-date" datetime={isoDate(data.date)}>{isoDate(data.date)} 分享</time>
  </div>
</li>
